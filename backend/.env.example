# Copy this file to .env (same folder) — or just use ⚙️ Settings in the app.
# .env is git-ignored, so your keys never reach GitHub.

# claude | openai | gemini | ollama | demo
EQL_AI_PROVIDER=claude

ANTHROPIC_API_KEY=
EQL_CLAUDE_MODEL=claude-sonnet-5-5

OPENAI_API_KEY=
EQL_OPENAI_MODEL=gpt-5.6-terra

# Free, local: install Ollama, then `ollama pull llama3.1:8b`
EQL_OLLAMA_URL=http://localhost:11434
EQL_OLLAMA_MODEL=llama3.1:8b

# Google Gemini (has a free tier): key from aistudio.google.com
GEMINI_API_KEY=
EQL_GEMINI_MODEL=gemini-3.8-flash
